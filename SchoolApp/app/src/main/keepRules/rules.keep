# Library consumer rules cover Retrofit, OkHttp, kotlinx.serialization, Room, Hilt and Navigation.

# Release builds plant no Timber tree; also drop verbose/debug/info call sites and their string building.
-assumenosideeffects class android.util.Log {
    public static int v(...);
    public static int d(...);
    public static int i(...);
}
-assumenosideeffects class timber.log.Timber$Forest {
    public void v(...);
    public void d(...);
    public void i(...);
}
