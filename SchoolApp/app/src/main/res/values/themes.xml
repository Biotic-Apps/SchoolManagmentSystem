<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SchoolApp" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
    </style>

    <!-- Launch theme: the brand mark on the light background until the session check finishes. -->
    <style name="Theme.SchoolApp.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.SchoolApp</item>
    </style>
</resources>
