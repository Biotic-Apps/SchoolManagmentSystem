<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Mirrors backup_rules.xml for cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="schoolapp.db" />
        <exclude domain="database" path="schoolapp.db-shm" />
        <exclude domain="database" path="schoolapp.db-wal" />
        <exclude domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="schoolapp.db" />
        <exclude domain="database" path="schoolapp.db-shm" />
        <exclude domain="database" path="schoolapp.db-wal" />
        <exclude domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
