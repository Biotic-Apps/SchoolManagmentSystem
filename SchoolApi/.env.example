NODE_ENV=development
PORT=3000
# Public base URL of this API (used in signed file URLs)
APP_URL=http://localhost:3000
# School wall clock for attendance day, lock times and office hours.
APP_TIMEZONE=Asia/Karachi

# Local dev: `npm run db:local` (embedded PostgreSQL on 5433)
DATABASE_URL=postgresql://eschool:eschool@localhost:5433/eschool?schema=public
REDIS_URL=redis://localhost:6379

# bullmq|inline and redis|memory. inline/memory are rejected in production.
JOBS_DRIVER=inline
CACHE_DRIVER=memory

JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

THROTTLE_LIMIT=300
AUTH_THROTTLE_LIMIT=10

CORS_ORIGINS=http://localhost:3001
# Express trust proxy allow-list (IPs/CIDRs or loopback). Unset = loopback in dev, none in production.
# Put the web BFF / load balancer here so rate limits and audit see the real client IP.
# TRUSTED_PROXIES=127.0.0.1,::1

# local|s3 (s3 = AWS S3 / MinIO / R2; S3_BUCKET + keys required, S3_ENDPOINT only for non-AWS)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage
FILE_URL_SECRET=change-me-file-url-secret-at-least-32-characters

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=eschool
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_FORCE_PATH_STYLE=true

# Antivirus (ClamAV clamd TCP). Unset = uploads are not scanned (scan_status stays PENDING).
# CLAMAV_HOST=localhost
# CLAMAV_PORT=3310

# Backups: AES-256-GCM key, 32 random bytes as base64 (required in production; keep it OUTSIDE the backup storage).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# BACKUP_ENCRYPTION_KEY=
BACKUP_RETENTION_DAILY=30
BACKUP_RETENTION_MONTHLY=12
# pg_dump / pg_restore binaries (PostgreSQL 16 client). Unset = looked up on PATH; in development, when not found,
# the built-in COPY dump is used instead (embedded-postgres does not ship pg_dump).
# PG_DUMP_PATH=/usr/bin/pg_dump
# PG_RESTORE_PATH=/usr/bin/pg_restore

# Two-factor sign-in (TOTP)
TOTP_ISSUER=eSchool
# 32 bytes base64 for TOTP secrets at rest. Unset = derived from JWT_REFRESH_SECRET (rotating that secret then resets 2FA).
# TWO_FACTOR_ENCRYPTION_KEY=

# prisma db seed
SEED_ADMIN_EMAIL=admin@eschool.local
SEED_ADMIN_PASSWORD=Demo@1234

# Push notifications: Firebase service account JSON (or a path to it). Unset = pushes are logged (dev).
# FCM_SERVICE_ACCOUNT_JSON=

# Email: log (default; printed to the console) | smtp. Production refuses "log" unless ALLOW_LOG_CHANNELS=true.
EMAIL_DRIVER=log
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# false = STARTTLS on 587 (required); true = implicit TLS on 465
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# The school's "from name" (Settings › Notifications) replaces the display name.
# EMAIL_FROM=eSchool <no-reply@example.com>

# SMS: log (default) | twilio | http. Production refuses "log" unless ALLOW_LOG_CHANNELS=true.
SMS_DRIVER=log
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+15005550006
# http = any local SMS gateway; {{to}}, {{message}}, {{senderId}} are filled in the URL and body. Success = 2xx.
# SMS_HTTP_URL=https://sms-gateway.example.com/send
# SMS_HTTP_METHOD=POST
# SMS_HTTP_HEADERS={"Authorization":"Bearer change-me","Content-Type":"application/json"}
# SMS_HTTP_BODY={"to":"{{to}}","text":"{{message}}","mask":"{{senderId}}"}

# Staging only: allow the log drivers in production (messages are then only logged, without bodies).
ALLOW_LOG_CHANNELS=false
# Country code for phone numbers typed without one (E.164 normalisation for SMS and parent phone sign-in).
DEFAULT_PHONE_COUNTRY=+92
