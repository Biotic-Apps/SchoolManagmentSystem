// Phase 5: other income (donations, rent, events, etc.) and P&L reports.

model IncomeCategory {
  id        String       @id @default(uuid(7)) @db.Uuid
  schoolId  String       @map("school_id") @db.Uuid
  code      String
  name      String
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  incomes Income[]

  @@unique([schoolId, code])
  @@map("income_categories")
}

model Income {
  id            String   @id @default(uuid(7)) @db.Uuid
  schoolId      String   @map("school_id") @db.Uuid
  branchId      String   @map("branch_id") @db.Uuid
  categoryId    String   @map("category_id") @db.Uuid
  title         String
  description   String?
  amountMinor   BigInt   @map("amount_minor")
  currency      String   @default("PKR") @db.Char(3)
  receivedOn    DateTime @map("received_on") @db.Date
  receiptFileId String?  @map("receipt_file_id") @db.Uuid
  notes         String?
  createdById   String   @map("created_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  category IncomeCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([branchId, receivedOn])
  @@index([categoryId])
  @@map("incomes")
}
