enum EnquiryStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED

  @@map("enquiry_status")
}

enum ApplicationStatus {
  SUBMITTED
  DOCUMENTS_PENDING
  TEST_SCHEDULED
  TEST_COMPLETED
  OFFERED
  WAITLISTED
  REJECTED
  CONFIRMED
  ENROLLED
  EXPIRED
  WITHDRAWN

  @@map("application_status")
}

model AdmissionEnquiry {
  id            String        @id @default(uuid(7)) @db.Uuid
  schoolId      String        @map("school_id") @db.Uuid
  branchId      String        @map("branch_id") @db.Uuid
  sessionId     String        @map("session_id") @db.Uuid
  classId       String        @map("class_id") @db.Uuid
  childName     String        @map("child_name")
  dob           DateTime?     @db.Date
  guardianName  String        @map("guardian_name")
  phone         String
  email         String?
  source        String?
  notes         String?
  followUpDate  DateTime?     @map("follow_up_date") @db.Date
  status        EnquiryStatus @default(NEW)
  applicationId String?       @unique @map("application_id") @db.Uuid
  createdById   String?       @map("created_by_id") @db.Uuid
  updatedById   String?       @map("updated_by_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  school      School                @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  branch      Branch                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  session     AcademicSession       @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  schoolClass SchoolClass           @relation(fields: [classId], references: [id], onDelete: Restrict)
  application AdmissionApplication? @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  @@index([schoolId])
  @@index([branchId, status])
  @@index([sessionId])
  @@index([classId])
  @@map("admission_enquiries")
}

/// Child, guardians and medical are the submitted form (JSON snapshot) until confirmation creates the real records.
model AdmissionApplication {
  id               String            @id @default(uuid(7)) @db.Uuid
  schoolId         String            @map("school_id") @db.Uuid
  branchId         String            @map("branch_id") @db.Uuid
  sessionId        String            @map("session_id") @db.Uuid
  classId          String            @map("class_id") @db.Uuid
  applicationNo    String            @map("application_no")
  status           ApplicationStatus @default(SUBMITTED)
  childName        String            @map("child_name")
  child            Json
  guardians        Json
  medical          Json?
  notes            String?
  waitlistPosition Int?              @map("waitlist_position")
  decisionReason   String?           @map("decision_reason")
  withdrawReason   String?           @map("withdraw_reason")
  admissionFee     Json?             @map("admission_fee")
  sectionId        String?           @map("section_id") @db.Uuid
  studentId        String?           @unique @map("student_id") @db.Uuid
  decidedById      String?           @map("decided_by_id") @db.Uuid
  decidedAt        DateTime?         @map("decided_at") @db.Timestamptz(3)
  createdById      String?           @map("created_by_id") @db.Uuid
  updatedById      String?           @map("updated_by_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  school      School            @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  branch      Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  session     AcademicSession   @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  schoolClass SchoolClass       @relation(fields: [classId], references: [id], onDelete: Restrict)
  student     Student?          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  enquiry     AdmissionEnquiry?
  test        EntranceTest?

  @@unique([branchId, applicationNo])
  @@unique([sessionId, classId, waitlistPosition], map: "admission_applications_waitlist_position", where: raw("status = 'WAITLISTED'::application_status"))
  @@index([schoolId])
  @@index([branchId, sessionId, status])
  @@index([classId])
  @@map("admission_applications")
}

model EntranceTest {
  id            String    @id @default(uuid(7)) @db.Uuid
  applicationId String    @unique @map("application_id") @db.Uuid
  scheduledAt   DateTime  @map("scheduled_at") @db.Timestamptz(3)
  venue         String?
  notes         String?
  score         Decimal?  @db.Decimal(6, 2)
  maxScore      Decimal?  @map("max_score") @db.Decimal(6, 2)
  remarks       String?
  scheduledById String    @map("scheduled_by_id") @db.Uuid
  recordedById  String?   @map("recorded_by_id") @db.Uuid
  recordedAt    DateTime? @map("recorded_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  @@map("entrance_tests")
}
