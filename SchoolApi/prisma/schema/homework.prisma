enum SubmissionStatus {
  SUBMITTED
  LATE
  GRADED
  RETURNED

  @@map("submission_status")
}

model Homework {
  id                String         @id @default(uuid(7)) @db.Uuid
  schoolId          String         @map("school_id") @db.Uuid
  branchId          String         @map("branch_id") @db.Uuid
  classId           String         @map("class_id") @db.Uuid
  sectionId         String         @map("section_id") @db.Uuid
  subjectId         String         @map("subject_id") @db.Uuid
  title             String
  description       String
  dueDate           DateTime       @map("due_date") @db.Date
  maxMarks          Int?           @map("max_marks")
  attachmentFileIds String[]       @default([]) @map("attachment_file_ids") @db.Uuid
  assignedById      String         @map("assigned_by_id") @db.Uuid
  status            RecordStatus   @default(ACTIVE)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  section     Section              @relation("HomeworkSection", fields: [sectionId], references: [id], onDelete: Restrict)
  subject     Subject              @relation("HomeworkSubject", fields: [subjectId], references: [id], onDelete: Restrict)
  assignedBy  User                 @relation("HomeworkAssigner", fields: [assignedById], references: [id], onDelete: Restrict)
  submissions HomeworkSubmission[]

  @@index([sectionId, dueDate])
  @@index([branchId, dueDate])
  @@index([schoolId, status])
  @@map("homework")
}

model HomeworkSubmission {
  id          String           @id @default(uuid(7)) @db.Uuid
  homeworkId  String           @map("homework_id") @db.Uuid
  studentId   String           @map("student_id") @db.Uuid
  submittedAt DateTime         @default(now()) @map("submitted_at") @db.Timestamptz(3)
  text        String?
  fileIds     String[]         @default([]) @map("file_ids") @db.Uuid
  marks       Int?
  grade       String?
  feedback    String?
  gradedById  String?          @map("graded_by_id") @db.Uuid
  gradedAt    DateTime?        @map("graded_at") @db.Timestamptz(3)
  status      SubmissionStatus @default(SUBMITTED)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  homework Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student  Student  @relation("StudentHomeworkSubmissions", fields: [studentId], references: [id], onDelete: Restrict)
  gradedBy User?    @relation("HomeworkGrader", fields: [gradedById], references: [id], onDelete: Restrict)

  @@unique([homeworkId, studentId])
  @@index([studentId])
  @@map("homework_submissions")
}
