# eSchool production settings for infra/docker-compose.prod.yml.
#   cp .env.production.example .env && chmod 600 .env
# This one file feeds compose (domains, DB/Redis passwords) AND the API container (env_file).
#
# Rules:
#   - Never commit infra/.env. Keep a copy of every secret in the school's password manager.
#   - Leave an optional setting COMMENTED OUT rather than blank: an empty value fails validation.
#   - Avoid "$" in values (compose interpolates it); the hex/base64 commands below never produce one.
#
# Generate secrets (run once each, on any machine with openssl or node):
#   openssl rand -hex 32                                   -> passwords, JWT/file secrets (64 chars)
#   openssl rand -base64 32                                -> BACKUP_ENCRYPTION_KEY, TWO_FACTOR_ENCRYPTION_KEY
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"   (same, without openssl)
#
# Set automatically by docker-compose.prod.yml (do not set here): NODE_ENV, PORT, APP_URL, CORS_ORIGINS,
# DATABASE_URL, REDIS_URL, JOBS_DRIVER, CACHE_DRIVER, TRUSTED_PROXIES, CLAMAV_HOST, CLAMAV_PORT, STORAGE_LOCAL_DIR,
# PG_DUMP_PATH, PG_RESTORE_PATH (baked into the API image).

# ---------------------------------------------------------------- Domains & TLS
# Web panel and API hostnames. DNS A (and AAAA) records must point at this server before first start.
APP_DOMAIN=portal.example-school.pk
API_DOMAIN=api.example-school.pk
# Let's Encrypt account / expiry notices.
ACME_EMAIL=it@example-school.pk
# Private docker network for the stack; the API trusts X-Forwarded-For only from here. Change only on a clash.
# DOCKER_SUBNET=172.30.0.0/24
# Image tag used by build/update (update.sh keeps the previous build as :previous).
# IMAGE_TAG=latest

# ---------------------------------------------------------------- Database (PostgreSQL 16)
POSTGRES_DB=eschool
# Superuser: maintenance and restores only. The app never uses it.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-openssl-rand-hex-32
# Application role (created on first start; owner of POSTGRES_DB, CREATEDB for restore checks).
APP_DB_USER=eschool_app
APP_DB_PASSWORD=change-me-openssl-rand-hex-32

# ---------------------------------------------------------------- Redis (jobs, cache, rate limits)
REDIS_PASSWORD=change-me-openssl-rand-hex-32

# ---------------------------------------------------------------- API: general
# School wall clock (attendance day, lock times, office hours, nightly jobs).
APP_TIMEZONE=Asia/Karachi
# Phone numbers written without a country code get this one (E.164).
DEFAULT_PHONE_COUNTRY=+92
THROTTLE_LIMIT=300
AUTH_THROTTLE_LIMIT=10

# ---------------------------------------------------------------- API: auth secrets (>= 32 chars, all different)
JWT_ACCESS_SECRET=change-me-openssl-rand-hex-32
JWT_REFRESH_SECRET=change-me-openssl-rand-hex-32
JWT_ACCESS_TTL=15m
# Also used by the web BFF for the refresh-cookie lifetime.
REFRESH_TTL_DAYS=30
# Signs the 5-minute file download links.
FILE_URL_SECRET=change-me-openssl-rand-hex-32
TOTP_ISSUER=eSchool
# 32 bytes base64. Unset = derived from JWT_REFRESH_SECRET (rotating that secret would then reset everyone's 2FA).
# TWO_FACTOR_ENCRYPTION_KEY=

# ---------------------------------------------------------------- Files
# local = named volume "apistorage" on this server (recommended for a single-server pilot);
# s3 = AWS S3 / Cloudflare R2 / MinIO (see docs/deployment.md "Object storage").
STORAGE_DRIVER=local
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=eschool-files
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_FORCE_PATH_STYLE=true
# Only with `--profile minio`:
# MINIO_ROOT_USER=eschool
# MINIO_ROOT_PASSWORD=

# ---------------------------------------------------------------- Backups (nightly 02:00, restore check Sunday 03:30)
# 32 bytes base64. REQUIRED. Store a copy OUTSIDE this server and outside the backup storage:
# without it no backup can ever be restored.
BACKUP_ENCRYPTION_KEY=change-me-openssl-rand-base64-32
BACKUP_RETENTION_DAILY=30
BACKUP_RETENTION_MONTHLY=12

# ---------------------------------------------------------------- Email (password reset, notifications)
# smtp in production. `log` is refused in production unless ALLOW_LOG_CHANNELS=true.
EMAIL_DRIVER=smtp
SMTP_HOST=smtp.example.com
# 587 + SMTP_SECURE=false = STARTTLS; 465 + SMTP_SECURE=true = implicit TLS.
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=change-me
SMTP_PASSWORD=change-me
# Display name is replaced by the school's notifications "from name" setting.
EMAIL_FROM="eSchool <no-reply@example-school.pk>"

# ---------------------------------------------------------------- SMS (parent OTP sign-in, alerts)
# twilio | http (any local SMS gateway). `log` is refused in production unless ALLOW_LOG_CHANNELS=true.
SMS_DRIVER=http
# --- twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+15550000000
# --- http gateway: success = any 2xx. Body placeholders: {{to}} {{message}} {{senderId}}. Unset body = JSON.
SMS_HTTP_URL=https://sms-gateway.example.pk/api/send
SMS_HTTP_METHOD=POST
# JSON object, single-quoted so the inner double quotes survive.
SMS_HTTP_HEADERS='{"Authorization":"Bearer change-me","Content-Type":"application/json"}'
# SMS_HTTP_BODY='{"to":"{{to}}","text":"{{message}}","sender":"{{senderId}}"}'

# Staging box only: allow EMAIL_DRIVER/SMS_DRIVER=log in production mode. Never true for the real pilot.
# ALLOW_LOG_CHANNELS=true

# ---------------------------------------------------------------- Push (Android)
# Firebase service account: JSON text or a path inside the container (mount it, see docker-compose.prod.yml).
# Unset = pushes are only logged.
# FCM_SERVICE_ACCOUNT_JSON=/run/secrets/fcm.json

# ---------------------------------------------------------------- Web (baked in at build time: rebuild web after a change)
# Auto sign-out after this many idle minutes (the school's session-timeout policy still applies).
WEB_IDLE_TIMEOUT_MINUTES=30
# Extra origins for images in the web CSP (comma list), e.g. a public S3 bucket URL. Empty = none.
# WEB_ASSET_ORIGINS=

# ---------------------------------------------------------------- First super admin (bootstrap only)
# Pass these on the command line for the one-time seed instead of storing them here (docs/deployment.md).
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=

# ---------------------------------------------------------------- Off-site backups (infra/scripts/backup-offsite.sh)
# rclone remote for the encrypted *.esbk backups, e.g. an S3/B2/R2 bucket or a Google Drive folder.
OFFSITE_REMOTE=offsite:eschool-backups
# rclone *crypt* remote for uploaded files (photos, documents are NOT encrypted on disk). Unset = files not copied.
# OFFSITE_FILES_REMOTE=offsite-crypt:files
# Directory holding rclone.conf on this server.
# RCLONE_CONFIG_DIR=/root/.config/rclone
