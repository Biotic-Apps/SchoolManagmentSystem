NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Server-only API URL used by the auth BFF (/api/auth/*); defaults to NEXT_PUBLIC_API_URL.
API_URL=

# Refresh-cookie lifetime (match the API's REFRESH_TTL_DAYS).
REFRESH_TTL_DAYS=30

# Auto sign-out after this many minutes without activity.
NEXT_PUBLIC_IDLE_TIMEOUT_MINUTES=30

# Extra origins allowed for images/requests in the CSP (comma list), e.g. the S3 bucket URL.
NEXT_PUBLIC_ASSET_ORIGINS=

# Development only: preview the portal shell without the API.
# One role key or a comma list (first is active), e.g. PRINCIPAL or TEACHER,PARENT.
NEXT_PUBLIC_DEMO_ROLE=
